# ============================================
# DevPath Environment Variables
# ============================================

# Database
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/devpath

# NextAuth
NEXTAUTH_SECRET=your-secret-min-32-chars-change-this
NEXTAUTH_URL=http://localhost:3000

# OAuth Providers (optional)
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redis (optional — in-memory cache used if not set)
REDIS_URL=

# App URL (used in emails and sitemap)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Analytics (optional)
NEXT_PUBLIC_GA_ID=

# ── Stripe ──────────────────────────────────────────────────────────────────
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Create products/prices in Stripe Dashboard, then paste the Price IDs:
# Products: DevPath Pro (monthly + yearly), DevPath Team (monthly + yearly)
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...
STRIPE_TEAM_MONTHLY_PRICE_ID=price_...
STRIPE_TEAM_YEARLY_PRICE_ID=price_...

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_...
EMAIL_FROM=DevPath <onboarding@yourdomain.com>
